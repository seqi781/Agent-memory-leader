[Unit]
Description=AML memory Add/Search service
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/aml-memory
# Fewer glibc malloc arenas: avoids RSS growth from fragmentation across request threads.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/aml-memory/.venv/bin/uvicorn aml_memory.main:app --host 127.0.0.1 --port 8000 --workers 3 --timeout-keep-alive 75
Restart=always
RestartSec=3
LimitNOFILE=65535
# Safety net: if memory ever runs away, systemd restarts the service (the platform retries 5xx).
MemoryHigh=2600M
MemoryMax=3000M

[Install]
WantedBy=multi-user.target
