[Unit]
Description=AML memory Add/Search service
After=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/aml-memory
ExecStart=/opt/aml-memory/.venv/bin/uvicorn aml_memory.main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-keep-alive 75
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
