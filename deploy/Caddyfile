# HTTPS on the bare public IP: Let's Encrypt short-lived IP certificate, renewed automatically.
# (A domain on a mainland-China server without ICP filing is blocked on 80/443, an IP is not.)
{
	# Clients connecting to a bare IP send no SNI; serve the IP certificate for them.
	default_sni 111.229.167.172
}

https://111.229.167.172 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	encode gzip
	request_body {
		max_size 64MB
	}
	# The leaderboard key's endpoints are fixed to the root paths, so the root serves the current
	# version: v0.5 on the GPU host, reached over Tailscale (100.100.92.37:8010). /v5 is an alias.
	# v0.4 (local, port 8010) is under /v4 and v0.3 (local, port 8000) under /v3, for reproduction.
	handle_path /v3/* {
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle_path /v5/* {
		reverse_proxy 100.100.92.37:8010 {
			transport http {
				dial_timeout 10s
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle_path /v4/* {
		reverse_proxy 127.0.0.1:8010 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle {
		reverse_proxy 100.100.92.37:8010 {
			transport http {
				dial_timeout 10s
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
}
