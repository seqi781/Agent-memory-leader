# HTTPS on the bare public IP: Let's Encrypt short-lived IP certificate, renewed automatically.
# (A domain on a mainland-China server without ICP filing is blocked on 80/443, an IP is not.)
{
	# Clients connecting to a bare IP send no SNI; serve the IP certificate for them.
	default_sni 111.229.167.172
}

https://111.229.167.172 {
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	encode gzip
	request_body {
		max_size 64MB
	}
	# The leaderboard key's endpoints are fixed to the root paths, so the root serves the current
	# version (v0.4, port 8010). v0.3 (port 8000, Full finished) stays reachable under /v3 for
	# reproduction; /v4 is an alias of the root.
	handle_path /v3/* {
		reverse_proxy 127.0.0.1:8000 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle_path /v4/* {
		reverse_proxy 127.0.0.1:8010 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8010 {
			transport http {
				read_timeout 30m
				write_timeout 30m
			}
		}
	}
}
