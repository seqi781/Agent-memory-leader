# v0.6 submitted configuration (GPU host). Secrets are not included: set AML_SERVICE_KEY and
# EMBED_API_KEY (DashScope) yourself. Service unit: deploy/aml-memory-v5.service (4 workers).
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_IPV4=1
NOTES=0
QUERY_EXPAND=0
RERANK_BACKEND=torch
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_TOKENS=512
RERANK_CHARS=1500
RERANK_BATCH=32
RERANK_TOP=50
OPTION_MERGE=1
OPTION_LIST=100
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
