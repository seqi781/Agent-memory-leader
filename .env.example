# Embedding key for text-embedding-v4 (Alibaba Cloud DashScope), used by v0.4 at Add and Search time
DASHSCOPE_API_KEY=sk-xxx
# OpenAI-compatible embedding endpoint: cn (default) or intl (https://dashscope-intl.aliyuncs.com/compatible-mode/v1)
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Key the AML platform must send (Authorization: Bearer <key>); leave empty to disable auth
AML_SERVICE_KEY=
# Optional: gpt-4o-mini via OpenRouter, for local evaluation and the optional NOTES / QUERY_EXPAND steps (off by default)
OPENROUTER_API_KEY=
