# Alibaba Cloud Model Studio (DashScope) key for text-embedding-v4
DASHSCOPE_API_KEY=sk-xxx
# intl (Singapore, dashscope-intl.aliyuncs.com) or cn (dashscope.aliyuncs.com)
DASHSCOPE_REGION=intl
# Key the AML platform must send (Authorization: Bearer <key>); leave empty to disable auth
AML_SERVICE_KEY=
# Optional, for local evaluation with gpt-4o-mini via OpenRouter (not used by the service)
OPENROUTER_API_KEY=
